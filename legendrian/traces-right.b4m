// openai-wiles/legendrian/traces-right.b4m — reference [6]'s stabilization traces, with the
// reverse-trace sign AS OPENAI'S WITHDRAWAL NOTICE SAYS IT SHOULD BE: -1.
//
// This file and `traces-right.b4m` differ in EXACTLY ONE VALUE — `reverseTraceSign`'s. They
// are the two horns of the live question about this manuscript, and each is imported by one
// of the two root files. See either root's header for the mechanism.
//
// T. Ekholm, Y. Eliashberg, E. Murphy, I. Smith, "Constructing exact Lagrangian immersions
// with few double points", Geom. Funct. Anal. 23 (2013) 1772-1803, arXiv:1303.0588v2 —
// the manuscript's reference [6], whose numbering it follows.
//
// Cited holes, read from the source. Note the sign assignments live in Lemma 3.4's PROOF,
// not its statement — see the G1-G4 table below.

import integer <<< "std/integer.b4m"

sort Link // a Legendrian link
sort Nat2 // source dimension is 2k; `half` is k
sort Int = integer.Int
const ZERO = integer.ZERO
const ONE = integer.ONE
func neg = integer.neg
func add = integer.add
func mul = integer.mul

// `stabilize(L)` is the U-stabilization of L ([6] §2.1).
func stabilize(l: Link) => Link

// LOOSE ([6] §2, after Lemma 2.2): "A Legendrian submanifold is loose if it is isotopic to
// the stabilization of another Legendrian knot."
pred isLoose(l: Link)

// A STABILIZATION IS LOOSE — [6] §2.2, definitional.
//
// [6] §2.2's definition: "A Legendrian submanifold is loose if it is isotopic to the
// stabilization of another Legendrian knot." (NOT Lemma 2.2, which is a formal-isotopy
// statement with a chi(U) = 0 hypothesis.)
hole aStabilizationIsLoose cites "arXiv:1303.0588v2 (Ekholm-Eliashberg-Murphy-Smith) §2.2: a Legendrian is loose iff isotopic to a stabilization": forall l: Link; isLoose(stabilize(l))

// -- the two trace signs, at source dimension 8 (k = 4) -------------------------------------
//
// [6, Lemma 3.4, third bullet], verbatim:
//
//   "if n = 2k then, for any phi, we can arrange that I(h1^-) = (-1)^{k-1}, and if in
//    ADDITION phi is assumed to be a LOOSE Legendrian knot, then we can arrange also that
//    I(h1^-) = (-1)^k."
//
// At k = 4: (-1)^{k-1} = -1 and (-1)^k = +1. The manuscript's equation (3.6) quotes this
// correctly. But quoting the STATEMENT is not enough — which trace gets which sign is
// settled in the PROOF (arXiv:1303.0588v2, p. 14), where four Lagrangian immersions are
// built and their indices assigned:
//
//   G1:  phi      -> phi_1     (stabilize)      I(G1) = (-1)^{k-1} = -1
//   G2:  phi_1    -> phi       (REVERSE)        I(G2) = (-1)^k     = +1
//   G3:  phi_{-1} -> phi       (from destab.)   I(G3) = (-1)^{k-1} = -1
//   G4:  phi      -> phi_{-1}  (DESTABILIZE)    I(G4) = (-1)^k     = +1
//
// So the LOOSENESS hypothesis belongs to G3/G4 — the destabilization direction, which needs
// Corollary 2.5 to produce phi_{-1}. G2, the reverse trace phi_1 -> phi, needs NO looseness:
// phi_1 is a stabilization and hence already loose, and G2 comes from Lemma 2.1 applied to
// the same homotopy {phi_t} as G1. Guarding G2 on isLoose(phi) was this file's own error.
//
// `traceSign(source, target)` is the signed double count contributed by one trace.
func traceSign(source: Link, target: Link) => Int

// FORWARD trace, l -> stabilize(l): sign (-1)^{k-1} = -1 at k = 4. Available FOR ANY l —
// the source says "for any phi", so this axiom carries no hypothesis.
hole forwardTraceSign cites "arXiv:1303.0588v2 Lemma 3.4 + proof p.14: I(G1) = (-1)^{k-1}, G1 going phi -> phi_1": forall l: Link;
  traceSign(l, stabilize(l)) = neg(ONE)

// REVERSE trace, stabilize(l) -> l. UNCONDITIONAL — no looseness hypothesis, per the G1-G4
// table above. The VALUE is where this file differs from `traces-wrong.b4m`.
//
// THE SIGN AS THE WITHDRAWAL NOTICE GIVES IT. Verbatim:
//
//   "The proof assigns each reverse stabilization trace sign +1 and therefore claims that
//    inserting m such traces makes the signed count zero. Accounting for the opposite source
//    orientations of the two branches of the standard cusp gives sign -1 for each reverse
//    trace in this convention. The resulting count is therefore I_new = I(f1) - m = -2m != 0."
//
// Note what this is NOT: it is not a claim that [6] is wrong. [6] assigns I(G2) = (-1)^k = +1
// in ITS OWN convention (the G1-G4 table above), and the manuscript quotes that correctly.
// The notice asserts a CONVENTION MISMATCH between [6]'s index I and the manuscript's signed
// double-point count. `traces-wrong.b4m` takes [6]'s value; this file takes the notice's.
hole reverseTraceSign cites "arXiv:1303.0588v2 Lemma 3.4 + proof p.14 gives I(G2) = (-1)^k for G2 going phi_1 -> phi; OpenAI's withdrawal notice states the sign is the opposite in the manuscript's own convention. The two chains of this directory take the two values": forall l: Link;
  traceSign(stabilize(l), l) = neg(ONE)

// -- the sign, exported for the shared §3.4 file -------------------------------------------
//
// `theReverseTraceSignValue` is THIS module's value for a reverse trace. The §3.4 file is
// written against this name and is byte-identical in both chains; only the value differs,
// so a reader must follow the arithmetic rather than read an answer off a theorem name.
const theReverseTraceSignValue: Int

// the notice's value.
hole theReverseTraceSignValueIs
  cites "see reverseTraceSign above — this names its value so the shared §3.4 file can be chain-neutral":
  theReverseTraceSignValue = neg(ONE)

theorem theReverseTraceSignIsItsValue: forall l: Link;
  traceSign(stabilize(l), l) = theReverseTraceSignValue
proof
  @the-value |
    theReverseTraceSignValue = neg(ONE)
    [by cite theReverseTraceSignValueIs]
  @generalize-l |
    fix l: Link {
      @the-trace-at-l |
        traceSign(stabilize(l), l) = neg(ONE)
        [using specialize reverseTraceSign(l)]
      @conclusion-at-l |
        traceSign(stabilize(l), l) = theReverseTraceSignValue
        [by rewrite the-value the-trace-at-l]
    }
  @conclusion |
    forall l: Link; traceSign(stabilize(l), l) = theReverseTraceSignValue
    [by generalize generalize-l]
qed

// THE ARITHMETIC THIS CHAIN'S SIGN PRODUCES, for the shared §3.4 file.
//
// m inserted reverse traces at sign s contribute m*s, so the count is I(f1) + (-I(f1))*s.
// §3.4 claims that is ZERO. Whether it is depends on s, which is why this theorem lives in
// the per-chain module: with s = +1 it holds, with s = -1 the kernel refuses it.
theorem theSignMakesTheCountVanish: forall i: Int;
  add(i, mul(neg(i), theReverseTraceSignValue)) = ZERO
proof
  @the-value |
    theReverseTraceSignValue = neg(ONE)
    [by cite theReverseTraceSignValueIs]
  @generalize-i |
    fix i: Int {
      @the-arithmetic-at-the-value |
        add(i, mul(neg(i), neg(ONE))) = ZERO
        [using polynomial(integer)]
      @conclusion-at-i |
        add(i, mul(neg(i), theReverseTraceSignValue)) = ZERO
        [by rewrite the-value the-arithmetic-at-the-value]
    }
  @conclusion |
    forall i: Int; add(i, mul(neg(i), theReverseTraceSignValue)) = ZERO
    [by generalize generalize-i]
qed
